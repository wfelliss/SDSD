# JWT
JWT_SECRET=your-secret-here-generate-with-openssl-rand-base64-64
# in cmd run node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"

# Database (use this for Docker setup)
DATABASE_URL=postgresql://postgres:password@localhost:5432/nestjs_app

# Server
PORT=3001
NODE_ENV=development

# Alternative for local PostgreSQL installation:
# DATABASE_URL=postgresql://localhost:5432/nestjs_app