# JWT
JWT_SECRET=your-secret-here-generate-with-openssl-rand-base64-64
# in cmd run node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
ESP32_API_KEY=the-esp-api-key
# in cmd generate one with node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"


SEED_ADMIN_PASSWORD="your-admin-password"

# Database (use this for Docker setup)
DATABASE_URL=postgresql://postgres:password@localhost:5432/nestjs_app

# Sentry — get the DSN from sentry.io > Project Settings > Client Keys (DSN).
# Leave blank to disable Sentry (SDK is a no-op without a DSN).
SENTRY_DSN="https://11076774135a9f7196af84479cbb03fa@o4511688524300288.ingest.de.sentry.io/4511688606875728"
SENTRY_ENVIRONMENT="development"

# Server
PORT=3001
NODE_ENV=development

# Alternative for local PostgreSQL installation:
# DATABASE_URL=postgresql://localhost:5432/nestjs_app