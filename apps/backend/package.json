{
  "name": "backend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
      "build": "nest build",
      "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
      "start": "bun run dist/main.js",
      "dev": "nest start --watch --exec bun",
      "start:debug": "nest start --debug --watch --exec bun",
      "start:prod": "bun run dist/main.js",
      "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
      "test": "bun test",
      "test:watch": "bun test --watch",
      "test:cov": "bun test --coverage",
      "test:debug": "bun --inspect-brk test",
      "test:e2e": "bun test --config ./test/jest-e2e.json",
      "check-types": "tsc --noEmit"
    },
  "dependencies": {
    "@nestjs/common": "^10.4.4",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.4",
    "@nestjs/platform-express": "^10.4.4",
    "@repo/database": "*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.3",
    "drizzle-orm": "^0.33.0",
    "multer": "^1.4.5-lts.1",
    "postgres": "^3.4.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.1.4",
    "@nestjs/testing": "^10.4.4",
    "@repo/eslint-config": "*",
    "@repo/typescript-config": "*",
    "@types/express": "^5.0.6",
    "@types/jest": "^29.5.13",
    "@types/multer": "^1.4.7",
    "@types/node": "^22.15.3",
    "@types/supertest": "^6.0.2",
    "bun-types": "^1.3.6",
    "drizzle-kit": "^0.24.2",
    "eslint": "^9.38.0",
    "jest": "^29.7.0",
    "prettier": "^3.6.2",
    "source-map-support": "^0.5.21",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "5.9.2",
    "typescript-eslint": "^8.53.0"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
